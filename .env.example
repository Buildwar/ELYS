# ==========================================
# ELYS — Environment Configuration
# ==========================================

# Port where ELYS server listens
PORT=4800

# Node environment (development | production)
NODE_ENV=production

# Persistent data directory for SQLite database
DATA_DIR=./data

# Secret key used for signing JWT authentication tokens (generate a strong random secret)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_2026

# Master key used for AES-256-GCM credential encryption at rest (generate a strong random secret)
# If omitted, an authenticated key is safely derived from JWT_SECRET
ENCRYPTION_KEY=super_secret_master_encryption_key_change_me_2026

# Allowed CORS origins (comma-separated, or leave empty for same-origin)
ALLOWED_ORIGINS=http://localhost:4800,http://localhost:5173

# Default Timezone for the Scheduler
TZ=UTC
